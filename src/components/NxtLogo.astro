---
// The NXT Partners AI logo, embedded from NXT's own finished asset the same way
// nxt-pe's NXTLogo.tsx does it: a 308x100 iframe scaled with transform (not zoom,
// which leaves white boxes in Safari). Dark-background variant only. Decorative:
// hidden from assistive tech and from clicks, so the parent link carries the name
// and receives the click. Styles are inline, as in NXTLogo.tsx: the frame must be
// sized before anything else loads, or it falls back to the browser's 300x150.
import { NXT_SITE } from '../config/nav';

interface Props {
  /** Rendered height in px. Width follows the asset's 308:100 frame. */
  height?: number;
}

const { height = 32 } = Astro.props;
const FRAME_W = 308;
const FRAME_H = 100;
const scale = height / FRAME_H;
---

<span
  class="nxt-logo"
  style={`display:block;flex-shrink:0;overflow:hidden;width:${FRAME_W * scale}px;height:${height}px`}
>
  <iframe
    src={NXT_SITE.logoDark}
    title=""
    aria-hidden="true"
    tabindex="-1"
    loading="eager"
    style={`display:block;width:${FRAME_W}px;height:${FRAME_H}px;border:0;pointer-events:none;transform-origin:0 0;transform:scale(${scale})`}
  ></iframe>
</span>
