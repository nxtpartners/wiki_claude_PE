---
// Top bar: NXT logo (out to the NXT site) + wordmark (home) on the left,
// Home button + search trigger on the right. Sticky, dark chrome.
import { withBase } from '../utils/withBase';
import { NXT_SITE } from '../config/nav';
import NxtLogo from './NxtLogo.astro';
import ExternalLink from './ExternalLink.astro';

const homeHref = withBase('/');
const onHome = Astro.url.pathname === homeHref;
---

<header class="site-header">
  <div class="header-inner">
    <div class="brand">
      <ExternalLink href={NXT_SITE.url} class="brand-logo">
        <span class="visually-hidden">{NXT_SITE.name}</span>
        <NxtLogo height={30} />
      </ExternalLink>
      <span class="mark-x" aria-hidden="true">&middot;</span>
      <a href={homeHref} class="wordmark" aria-label="Claude for Private Equity, home">
        <span class="mark-claude">Claude</span>
        <span class="mark-sub">for Private Equity</span>
      </a>
    </div>

    <div class="header-right">
      <a href={homeHref} class="chrome-btn" aria-label="Home" aria-current={onHome ? 'page' : undefined}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
        <span class="chrome-btn-label">Home</span>
      </a>
      <button type="button" class="chrome-btn" id="search-trigger" aria-label="Search the wiki">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span class="chrome-btn-label">Search</span>
        <kbd class="search-kbd">/</kbd>
      </button>
    </div>
  </div>

  <!-- Reading-progress bar (GSAP-driven on doc pages; harmless elsewhere). -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
</header>

<!-- Search dialog (Pagefind UI mounted lazily) -->
<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-panel-head">
      <span class="eyebrow" style="margin:0">Search</span>
      <button type="button" class="search-close" id="search-close" aria-label="Close search">Esc</button>
    </div>
    <div id="pagefind-search"></div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--chrome-bg);
    border-bottom: 1px solid var(--chrome-line);
  }
  .header-inner {
    height: var(--header-h);
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .brand-logo {
    display: inline-flex;
    border-radius: var(--radius-sm);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--on-dark);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .wordmark:hover {
    text-decoration: none;
  }
  .mark-x {
    color: var(--on-dark-muted);
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1;
    margin-inline: 1px;
  }
  .mark-claude {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .mark-sub {
    color: var(--on-dark-muted);
    font-weight: 500;
    font-size: 0.92rem;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Home and Search share one button style. */
  .chrome-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--on-dark-muted);
    background: var(--chrome-fill);
    border: 1px solid var(--chrome-line);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      color 0.18s ease,
      background 0.18s ease;
  }
  .chrome-btn:hover {
    border-color: var(--brand-purple);
    color: var(--on-dark);
    text-decoration: none;
  }
  .chrome-btn[aria-current='page'] {
    color: var(--on-dark);
  }
  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: transparent;
    border: 1px solid var(--chrome-line);
    border-radius: 5px;
    padding: 1px 6px;
    color: var(--on-dark-muted);
  }

  .reading-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--brand-purple);
  }

  /* Search modal */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-modal[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: var(--chrome-scrim);
    backdrop-filter: blur(2px);
  }
  .search-panel {
    position: relative;
    width: min(640px, 92vw);
    max-height: 74vh;
    overflow: auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
  }
  .search-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .search-close {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 2px 8px;
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .mark-sub,
    .chrome-btn-label,
    .search-kbd {
      display: none;
    }
    .header-inner {
      padding-inline: var(--space-4);
    }
  }
</style>

<link href={withBase('/pagefind/pagefind-ui.css')} rel="stylesheet" />
<script>
  // ---- Pagefind search modal wiring ----
  const trigger = document.getElementById('search-trigger');
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const closeBtn = document.getElementById('search-close');
  let pagefindLoaded = false;

  function loadPagefind() {
    if (pagefindLoaded) return;
    pagefindLoaded = true;
    // pagefind-ui.js is emitted to /pagefind during the production build.
    // Inject it as a plain <script> at runtime so the bundler never tries to
    // resolve it (it does not exist until `pagefind` runs post-build).
    const init = () => {
      try {
        // @ts-ignore - runtime global from the injected script
        new window.PagefindUI({ element: '#pagefind-search', bundlePath: import.meta.env.BASE_URL + 'pagefind/', showSubResults: true, showImages: false });
      } catch {
        const el = document.getElementById('pagefind-search');
        if (el) el.innerHTML = '<p style="color:var(--ink-muted)">Search is available in the production build.</p>';
      }
    };
    // @ts-ignore
    if (window.PagefindUI) return init();
    const s = document.createElement('script');
    s.src = import.meta.env.BASE_URL + 'pagefind/pagefind-ui.js';
    s.onload = init;
    s.onerror = () => {
      const el = document.getElementById('pagefind-search');
      if (el) el.innerHTML = '<p style="color:var(--ink-muted)">Search is available in the production build.</p>';
    };
    document.head.appendChild(s);
  }

  function openSearch() {
    if (!modal) return;
    modal.hidden = false;
    loadPagefind();
    requestAnimationFrame(() => {
      const input = modal.querySelector('input');
      if (input instanceof HTMLInputElement) input.focus();
    });
  }
  function closeSearch() {
    if (modal) modal.hidden = true;
  }

  trigger?.addEventListener('click', openSearch);
  backdrop?.addEventListener('click', closeSearch);
  closeBtn?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !modal?.contains(document.activeElement) && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });
</script>
