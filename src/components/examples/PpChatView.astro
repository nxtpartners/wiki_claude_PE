---
// Submit view for the PortCo Pulse showcase: an operator at kpiCompany reports
// the month's KPIs by chatting with the app's assistant instead of filling in
// a form. Mirrors the original app's chat panel (assistant bar, "Submitting
// for" context bar, message bubbles, composer) and its confirmation card.
//
// The conversation is scripted (chatScript in pp-data.ts) and plays itself;
// the reader never types. Contract:
//  - Every message is in the DOM from the start. While the chat plays, the
//    messages not yet reached carry the shared .visually-hidden utility from
//    global.css, so screen readers and Pagefind always get the full text.
//  - The composer is decoration: aria-hidden and never focusable.
//  - When to play is not decided here. The showcase's motion helper sends
//    PP_VIEW_PHASE (arm / play / stop) exactly as it does to every view; this
//    script only runs the conversation and reports PP_VIEW_DONE at the end, so
//    the helper can hold the finished chat (data-pp-hold) and replay it.
//  - Stop (and prefers-reduced-motion: reduce) is the finished transcript.
import {
  assistantName,
  chatScript,
  chatSummary,
  docStateLabels,
  kpiCompany,
  kpiSections,
  kpiSourceLabels,
  period,
} from './pp-data';
import PpViewHeader from './PpViewHeader.astro';

const summarySections = kpiSections
  .map((section) => ({ section, rows: chatSummary.rows.filter((r) => r.section === section) }))
  .filter((s) => s.rows.length > 0);
---

<div class="pp-view" data-view="submit" data-pp-chat data-pp-scripted data-pp-hold="6000">
  <PpViewHeader eyebrow="Operator Submission" title="Submit KPIs by Chat" />

  <div class="pp-chat is-filed">
    <!-- Assistant bar -->
    <div class="pp-chat-bar">
      <span class="pp-chat-name">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
        {assistantName}
      </span>
    </div>

    <!-- Company context bar -->
    <div class="pp-chat-context">
      <span class="pp-chat-context-label">Submitting for</span>
      <span class="pp-chat-context-co">{kpiCompany}</span>
      <span class="pp-chat-context-period">{period}</span>
    </div>

    <!-- Conversation -->
    <div
      class="pp-chat-scroll"
      data-chat-scroll
      tabindex="0"
      role="region"
      aria-label={`Example conversation: ${kpiCompany} reports ${period} KPIs`}
    >
      <ol class="pp-chat-log">
        {
          chatScript.map((m) => (
            <li
              class:list={['pp-msg', `from-${m.role}`]}
              data-chat-msg
              data-role={m.role}
              data-attachment={m.attachment}
              data-files={m.filesSubmission ? '' : undefined}
            >
              <span class="visually-hidden">{m.role === 'assistant' ? assistantName : 'Operator'}:</span>
              <div class="pp-bubble">
                {m.detection && <p class="pp-detect">{m.detection}</p>}
                {m.attachment && (
                  <span class="pp-attach">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" aria-hidden="true">
                      <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="visually-hidden">Attached:</span>
                    {m.attachment}
                  </span>
                )}
                {m.text.map((t) => <p data-chat-text>{t}</p>)}
                {m.list && (
                  <ul class="pp-bubble-list">
                    {m.list.map((t) => <li>{t}</li>)}
                  </ul>
                )}
                {m.after?.map((t) => <p>{t}</p>)}
              </div>

              {m.showsSummary && (
                <div class="pp-card">
                  <div class="pp-card-head">
                    <div>
                      <p class="pp-card-co">{chatSummary.company}</p>
                      <p class="pp-card-period">{chatSummary.title}</p>
                    </div>
                    <span class="pp-badge st-ontrack pp-card-filed">
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" aria-hidden="true">
                        <path d="m5 12 4 4 10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      Submitted
                    </span>
                  </div>

                  <div class="pp-card-body">
                    <table class="pp-card-table">
                      <caption class="visually-hidden">{chatSummary.title}: KPIs against plan</caption>
                      <thead>
                        <tr>
                          <th scope="col">KPI</th>
                          <th scope="col">Actual</th>
                          <th scope="col">Plan</th>
                          <th scope="col">Var</th>
                          <th scope="col">Status</th>
                        </tr>
                      </thead>
                      {summarySections.map((s) => (
                        <tbody>
                          <tr class="pp-card-sec">
                            <th scope="colgroup" colspan="5">{s.section}</th>
                          </tr>
                          {s.rows.map((r) => (
                            <tr class="pp-card-row">
                              <th scope="row" class="pp-card-kpi">
                                {r.kpi}
                                <span class="pp-card-src">{kpiSourceLabels[r.source]}</span>
                              </th>
                              <td class="pp-card-num" data-label="Actual">{r.actual}</td>
                              <td class="pp-card-num" data-label="Plan">{r.plan}</td>
                              <td class="pp-card-num" data-label="Var">{r.variance}</td>
                              <td class="pp-card-status">
                                <span class:list={['pp-badge', `st-${r.status}`]}>{r.statusLabel}</span>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      ))}
                    </table>

                    <div class="pp-card-note">
                      <p class="pp-card-label">Overall note</p>
                      <p class="pp-card-note-text">{chatSummary.note}</p>
                    </div>

                    <div>
                      <p class="pp-card-label">Documents</p>
                      <ul class="pp-card-docs">
                        {chatSummary.docs.map((d) => (
                          <li class:list={['pp-badge', `doc-${d.state}`]}>
                            {d.label}
                            <span class="visually-hidden">{docStateLabels[d.state]}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="pp-card-foot" aria-hidden="true">
                    <span class="pp-card-btn">Cancel</span>
                    <span class="pp-card-btn is-primary">Submit</span>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ol>
      <div class="pp-typing" data-chat-typing hidden aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
    </div>

    <!-- Composer: shown as in the app, never usable here -->
    <div class="pp-composer" data-chat-composer aria-hidden="true">
      <div class="pp-composer-field">
        <span class="pp-composer-file" data-chat-file hidden></span>
        <span class="pp-composer-text" data-chat-draft></span>
        <span class="pp-composer-ph">Message…</span>
        <span class="pp-composer-tag">Demo</span>
      </div>
      <span class="pp-composer-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
          <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="pp-composer-btn is-send">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
          <path d="m22 2-7 20-4-9-9-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <path d="M22 2 11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
    </div>
    <p class="pp-composer-note">Demo: this example conversation plays on its own, so the message box is switched off.</p>
  </div>
</div>

<style>
  /* Every color is a wiki token, reached through the showcase's token map on
     .pp (--chrome, --accent, --st-*). Tints use color-mix. */
  .pp-chat {
    --chat-enter: 280ms;
    --chat-dot: 1.2s;

    display: flex;
    flex-direction: column;
    block-size: clamp(480px, 78vh, 660px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* ---- Assistant bar + context bar ---- */
  .pp-chat-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .pp-chat-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .pp-chat-name svg {
    color: var(--st-ontrack);
  }
  .pp-chat-context {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
  }
  .pp-chat-context-label {
    color: var(--ink-muted);
  }
  .pp-chat-context-co {
    font-weight: 650;
    color: var(--ink);
  }
  .pp-chat-context-period {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-muted);
  }

  /* ---- Conversation ---- */
  .pp-chat-scroll {
    position: relative;
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-4);
  }
  .pp-chat-scroll:focus-visible {
    outline-offset: -3px;
  }
  .pp-chat-log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* .pp-msg only lays out its children: the shared .visually-hidden utility is
     toggled on it, so it must never set position, size, overflow, or spacing. */
  .pp-msg {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .from-operator {
    align-items: flex-end;
  }
  .from-assistant {
    align-items: flex-start;
  }
  .pp-msg.is-entering {
    animation: pp-chat-enter var(--chat-enter) ease-out both;
  }

  .pp-bubble {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .pp-bubble p {
    margin: 0;
  }
  .pp-bubble p + p,
  .pp-bubble p + .pp-bubble-list,
  .pp-bubble-list + p {
    margin-top: var(--space-2);
  }
  .pp-bubble-list {
    margin: 0;
    padding-left: var(--space-5);
  }
  .pp-bubble-list li + li {
    margin-top: var(--space-1);
  }
  .from-operator .pp-bubble {
    max-inline-size: 85%;
    background: var(--chrome);
    color: var(--bg);
    border-end-end-radius: var(--radius-sm);
  }
  .from-assistant .pp-bubble {
    inline-size: 100%;
    background: var(--bg-soft);
    color: var(--ink);
    border-end-start-radius: var(--radius-sm);
  }
  .pp-bubble .pp-detect {
    font-size: 0.74rem;
    color: var(--ink-muted);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .pp-attach {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg) 16%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    overflow-wrap: anywhere;
  }

  /* ---- Typing indicator ---- */
  .pp-typing {
    display: inline-flex;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-soft);
    border-radius: var(--radius-lg);
    border-end-start-radius: var(--radius-sm);
  }
  .pp-typing[hidden] {
    display: none;
  }
  .pp-typing span {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--ink-muted);
    animation: pp-chat-dot var(--chat-dot) ease-in-out infinite;
  }
  .pp-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .pp-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  /* ---- Confirmation card ---- */
  .pp-card {
    container: pp-card / inline-size;
    inline-size: min(100%, 36rem);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .pp-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .pp-card-co {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 650;
    color: var(--ink);
  }
  .pp-card-period {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  /* Both selectors carry three classes so they outrank the shared
     .pp .pp-badge display rule in PortcoPulseShowcase. */
  .pp-chat .pp-card-head .pp-card-filed {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .pp-chat:not(.is-filed) .pp-card-filed {
    display: none;
  }
  .pp-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }
  .pp-card-table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .pp-card-table thead th {
    padding: 0 var(--space-2) var(--space-2) 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
  }
  .pp-card-table thead th:last-child {
    padding-right: 0;
    text-align: right;
  }
  .pp-card-sec th {
    padding: var(--space-3) 0 var(--space-1);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-muted);
  }
  .pp-card-row > * {
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .pp-card-kpi {
    font-weight: 500;
    text-align: left;
    color: var(--ink);
  }
  .pp-card-src {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .pp-card-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .pp-card-row > .pp-card-status {
    padding-right: 0;
    text-align: right;
  }
  .pp-card-label {
    margin: 0 0 var(--space-1);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .pp-card-note-text {
    margin: 0;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .pp-card-docs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .doc-in {
    --c: var(--st-ontrack);
  }
  .doc-out {
    --c: var(--st-offtrack);
  }
  .doc-na {
    --c: var(--ink-muted);
  }
  .pp-card-foot {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--line);
  }
  .pp-chat.is-filed .pp-card-foot {
    display: none;
  }
  .pp-card-btn {
    flex: 1;
    padding: var(--space-2);
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .pp-card-btn.is-primary {
    background: var(--chrome);
    border-color: var(--chrome);
    color: var(--bg);
  }

  /* Narrow card: each KPI becomes a small block, name and status on top,
     then actual, plan and variance in three equal columns with their labels
     above. Same idea as the Data view's stacked table. */
  @container pp-card (max-width: 420px) {
    .pp-card-table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .pp-card-table,
    .pp-card-table tbody,
    .pp-card-sec,
    .pp-card-sec th {
      display: block;
    }
    .pp-card-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        'kpi kpi status'
        'act plan var';
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--line);
    }
    .pp-card-row > *,
    .pp-card-row > .pp-card-status {
      padding: 0;
      border-bottom: none;
    }
    .pp-card-kpi { grid-area: kpi; }
    .pp-card-row > .pp-card-status {
      grid-area: status;
      justify-self: end;
    }
    .pp-card-num:nth-of-type(1) { grid-area: act; }
    .pp-card-num:nth-of-type(2) { grid-area: plan; }
    .pp-card-num:nth-of-type(3) { grid-area: var; }
    .pp-card-num::before {
      content: attr(data-label);
      display: block;
      font-size: 0.56rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .pp-card-head,
    .pp-card-body,
    .pp-card-foot {
      padding-inline: var(--space-4);
    }
  }

  /* ---- Composer (decorative, inert) ---- */
  .pp-composer {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-2);
    border-top: 1px solid var(--line);
    cursor: not-allowed;
    user-select: none;
  }
  .pp-composer-field {
    flex: 1 1 auto;
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 40px;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .pp-composer-file {
    flex: 0 1 auto;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .pp-composer-file[hidden] {
    display: none;
  }
  .pp-composer-text {
    flex: 1 1 auto;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  .pp-composer-text:empty {
    display: none;
  }
  .pp-composer-text:not(:empty) ~ .pp-composer-ph {
    display: none;
  }
  .pp-composer.is-typing .pp-composer-text::after {
    content: '';
    display: inline-block;
    inline-size: 1px;
    block-size: 1.05em;
    vertical-align: text-bottom;
    background: var(--ink);
    animation: pp-chat-caret 1s steps(1) infinite;
  }
  .pp-composer-ph {
    flex: 1 1 auto;
    color: var(--ink-muted);
  }
  .pp-composer-tag {
    flex: 0 0 auto;
    align-self: center;
    padding: 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .pp-composer-btn {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .pp-composer-btn.is-send {
    background: var(--chrome);
    border-color: var(--chrome);
    color: var(--bg);
    opacity: 0.4;
    transition: opacity 150ms ease;
  }
  .pp-composer.has-text .pp-composer-btn.is-send {
    opacity: 1;
  }
  .pp-composer-note {
    margin: 0;
    padding: 0 var(--space-4) var(--space-3);
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  @keyframes pp-chat-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes pp-chat-dot {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  @keyframes pp-chat-caret {
    50% {
      opacity: 0;
    }
  }

  /* Reduced motion: the helper keeps this view on its finished transcript,
     and nothing here should move. */
  @media (prefers-reduced-motion: reduce) {
    .pp-msg.is-entering,
    .pp-typing span,
    .pp-composer.is-typing .pp-composer-text::after {
      animation: none;
    }
    .pp-composer-btn.is-send {
      transition: none;
    }
  }
</style>

<script>
  // Runs the scripted chat. One engine per Submit view on the page; the
  // showcase's motion helper decides when (PP_VIEW_PHASE), this decides how.
  // Every pending step is a timer in `timers`, and every run has an id: stop()
  // clears the timers and bumps the id, so a stale step can never fire and a
  // phase change can never leave two runs going at once.
  import { PP_VIEW_DONE, PP_VIEW_PHASE, type PpViewPhaseDetail } from './pp-data';

  // All timing lives here, in milliseconds.
  const TIMING = {
    firstReply: 800, // typing dots before the greeting
    replyBase: 700, // typing dots before a later reply...
    replyPerChar: 4, // ...plus a little per character of that reply
    replyMax: 1900,
    operatorPause: 900, // the operator reads, then starts typing
    keyMin: 18, // per keystroke, randomized between min and max
    keyMax: 46,
    beforeSend: 380, // last keystroke to send
    settle: 500, // after a message lands; after the last one, PP_VIEW_DONE
    userScrollWindow: 250, // a scroll this soon after wheel/touch/key input is the reader's
  };
  const FOLLOW_SLACK_PX = 32; // "at the bottom" tolerance for auto-follow
  const HIDDEN = 'visually-hidden'; // shared utility in global.css
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-pp-chat]').forEach((view) => {
    const chat = view.querySelector<HTMLElement>('.pp-chat');
    const scroller = view.querySelector<HTMLElement>('[data-chat-scroll]');
    const typing = view.querySelector<HTMLElement>('[data-chat-typing]');
    const composer = view.querySelector<HTMLElement>('[data-chat-composer]');
    const draft = view.querySelector<HTMLElement>('[data-chat-draft]');
    const file = view.querySelector<HTMLElement>('[data-chat-file]');
    const messages = Array.from(view.querySelectorAll<HTMLElement>('[data-chat-msg]'));
    if (!chat || !scroller || !typing || !composer || !draft || !file || messages.length === 0) return;

    let runId = 0;
    const timers = new Set<number>();
    let follow = true; // keep the newest message in view
    let lastUserInput = 0;

    const wait = (id: number, ms: number) =>
      new Promise<boolean>((resolve) => {
        const t = window.setTimeout(() => {
          timers.delete(t);
          resolve(id === runId);
        }, ms);
        timers.add(t);
      });

    function stop() {
      runId += 1;
      timers.forEach((t) => window.clearTimeout(t));
      timers.clear();
    }

    function setDraft(text: string) {
      draft!.textContent = text;
      composer!.classList.toggle('has-text', text.length > 0);
    }

    function clearTransient() {
      typing!.hidden = true;
      file!.hidden = true;
      file!.textContent = '';
      composer!.classList.remove('is-typing');
      setDraft('');
    }

    function scrollToEnd() {
      if (!follow) return;
      scroller!.scrollTo({ top: scroller!.scrollHeight, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    }

    // Nothing said yet. Messages stay in the DOM, visually hidden.
    function reset() {
      stop();
      clearTransient();
      messages.forEach((m) => {
        m.classList.remove('is-entering');
        m.classList.add(HIDDEN);
      });
      chat!.classList.remove('is-filed');
      follow = true;
      scroller!.scrollTop = 0;
    }

    // The finished transcript, also the no-JS and reduced-motion state.
    function showAll() {
      stop();
      clearTransient();
      messages.forEach((m) => m.classList.remove(HIDDEN, 'is-entering'));
      chat!.classList.add('is-filed');
    }

    function reveal(m: HTMLElement) {
      m.classList.remove(HIDDEN);
      m.classList.add('is-entering');
      if (m.dataset.files !== undefined) chat!.classList.add('is-filed');
      scrollToEnd();
    }

    async function play() {
      reset();
      const id = runId;
      for (const [i, m] of messages.entries()) {
        if (m.dataset.role === 'assistant') {
          typing!.hidden = false;
          scrollToEnd();
          const chars = m.textContent?.length ?? 0;
          const ms = i === 0 ? TIMING.firstReply : Math.min(TIMING.replyMax, TIMING.replyBase + chars * TIMING.replyPerChar);
          if (!(await wait(id, ms))) return;
          typing!.hidden = true;
        } else {
          if (!(await wait(id, TIMING.operatorPause))) return;
          const text = Array.from(m.querySelectorAll('[data-chat-text]'))
            .map((p) => p.textContent?.trim() ?? '')
            .join(' ');
          if (m.dataset.attachment) {
            file!.textContent = m.dataset.attachment;
            file!.hidden = false;
            composer!.classList.add('has-text');
          }
          composer!.classList.add('is-typing');
          for (let n = 1; n <= text.length; n += 1) {
            setDraft(text.slice(0, n));
            const key = TIMING.keyMin + Math.random() * (TIMING.keyMax - TIMING.keyMin);
            if (!(await wait(id, key))) return;
          }
          if (!(await wait(id, TIMING.beforeSend))) return;
          clearTransient();
        }
        reveal(m);
        if (!(await wait(id, TIMING.settle))) return;
      }
      view.dispatchEvent(new CustomEvent(PP_VIEW_DONE));
    }

    view.addEventListener(PP_VIEW_PHASE, (e) => {
      const { phase } = (e as CustomEvent<PpViewPhaseDetail>).detail;
      if (phase === 'arm') reset();
      else if (phase === 'play') void play();
      else showAll();
    });

    // Auto-follow the newest message unless the reader scrolls away from the
    // bottom; scrolling back to the bottom resumes it. Only scrolls that follow
    // real input count, so the script's own smooth scrolling never cancels it.
    const noteInput = () => {
      lastUserInput = performance.now();
    };
    scroller.addEventListener('wheel', noteInput, { passive: true });
    scroller.addEventListener('touchmove', noteInput, { passive: true });
    scroller.addEventListener('keydown', noteInput);
    scroller.addEventListener(
      'scroll',
      () => {
        if (performance.now() - lastUserInput > TIMING.userScrollWindow) return;
        follow = scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight < FOLLOW_SLACK_PX;
      },
      { passive: true },
    );
  });
</script>
