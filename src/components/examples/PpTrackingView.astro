---
// Submission tracking view for the PortCo Pulse showcase.
import { trackingRows, docLabels, period, fiscalYear } from './pp-data';
---

<div class="pp-view" data-view="tracking">
  <!-- Tracking header -->
  <div class="pp-head">
    <div>
      <p class="pp-eyebrow">Submissions</p>
      <h3 class="pp-title">Submission Tracking</h3>
    </div>
    <span class="pp-fy">{fiscalYear} plan</span>
  </div>

  <!-- Submission tracking -->
  <div class="pp-panel">
    <div class="pp-panel-head">
      <h4 class="pp-panel-title">Submission Tracking</h4>
      <span class="pp-panel-note">{period}</span>
    </div>
    <div class="pp-track">
      <div class="pp-track-head" aria-hidden="true">
        <span class="pp-track-co">Company</span>
        {docLabels.map((d) => <span class="pp-track-doc">{d}</span>)}
      </div>
      {
        trackingRows.map((row) => (
          <div class="pp-track-row">
            <span class="pp-track-co">{row.name}</span>
            {row.docs.map((state, i) => (
              <span class="pp-track-cell">
                <span class="pp-track-doclabel" aria-hidden="true">{docLabels[i]}</span>
                <span class:list={['pp-chip', `chip-${state}`]} aria-label={docLabels[i] + ' ' + (state === 'in' ? 'submitted' : state === 'out' ? 'missing' : 'not required')}>
                  {state === 'in' && (
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
                      <path d="m5 12 4 4 10-10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {state === 'out' && (
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
                      <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    </svg>
                  )}
                  {state === 'na' && (
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" aria-hidden="true">
                      <path d="M6 12h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
    <div class="pp-track-summary">
      <span class="pp-track-stat"><span class="dot dot-in" aria-hidden="true"></span>6 complete</span>
      <span class="pp-track-stat"><span class="dot dot-part" aria-hidden="true"></span>1 partial</span>
      <span class="pp-track-stat"><span class="dot dot-out" aria-hidden="true"></span>1 missing</span>
      <span class="pp-track-pct">86% complete</span>
    </div>
  </div>
</div>

<style>
  /* ---- View header (duplicated per Astro scoping) ---- */
  .pp-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .pp-eyebrow {
    margin: 0 0 2px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kpmg-cobalt);
  }
  .pp-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pp-fy {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
  }

  /* ---- Switchable views ---- */
  .pp-view {
    display: none;
    flex-direction: column;
    gap: var(--space-6);
  }
  .pp-view.active {
    display: flex;
  }

  /* ---- Panels ---- */
  .pp-panel {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .pp-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .pp-panel-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--kpmg-blue);
  }
  .pp-panel-note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  /* ---- Submission tracking ---- */
  .pp-track {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .pp-track-head,
  .pp-track-row {
    display: grid;
    grid-template-columns: 1fr repeat(4, 48px);
    align-items: center;
    gap: var(--space-2);
    padding: 9px var(--space-4);
  }
  .pp-track-head {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .pp-track-head .pp-track-co,
  .pp-track-head .pp-track-doc {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: center;
  }
  .pp-track-head .pp-track-co {
    text-align: left;
  }
  .pp-track-row {
    border-bottom: 1px solid var(--line);
  }
  .pp-track-row:last-child {
    border-bottom: none;
  }
  .pp-track-co {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pp-track-cell {
    display: grid;
    place-items: center;
  }
  .pp-track-doclabel {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .pp-chip {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    --c: var(--ink-muted);
    background: color-mix(in srgb, var(--c) 12%, var(--bg));
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 30%, var(--bg));
  }
  .chip-in {
    --c: var(--kpmg-teal);
  }
  .chip-out {
    --c: var(--confidential);
  }
  .chip-na {
    --c: var(--ink-muted);
  }
  .pp-track-summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .pp-track-stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-in {
    background: var(--kpmg-teal);
  }
  .dot-part {
    background: var(--warning);
  }
  .dot-out {
    background: var(--confidential);
  }
  .pp-track-pct {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--kpmg-blue);
  }

  /* ---- Mobile: stacked tracking rows with inline doc labels ---- */
  @media (max-width: 720px) {
    .pp-track-head {
      display: none;
    }
    .pp-track-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .pp-track-cell {
      grid-template-columns: 1fr auto;
      display: grid;
      align-items: center;
      width: 100%;
    }
    .pp-track-doclabel {
      display: inline-block;
      justify-self: start;
    }
  }
</style>
