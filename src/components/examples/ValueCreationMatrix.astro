---
// AI Value Creation Matrix.
// A self-contained, re-skinned adaptation of a standalone KPMG deliverable:
// 19 AI value-creation use cases across five PE value levers, filterable by
// phase, fund tier, and KPMG service line.
//
// Design rules followed here:
//  - Never hardcode colors. Every hue is a wiki design token (--kpmg-blue,
//    --kpmg-cobalt, --kpmg-teal, --warning, --confidential, --ink-muted).
//    Badge tints are derived from those tokens with color-mix, so the whole
//    matrix stays on-palette with the rest of the wiki.
//  - No external fonts: Inter for body, JetBrains Mono (--font-mono) for the
//    micro-labels and badges.
//  - No em/en dashes anywhere. Ranges use a hyphen ("4-6 wks"); prose dashes
//    are rewritten as commas or colons.
//  - Mobile-adaptable: the wide table collapses to stacked cards under 720px
//    using data-label attributes; the .table-wrap keeps overflow-x for the
//    in-between range. No animation is added, so reduced-motion is respected.

import {
  serviceLabels, phaseMeta, tierMeta, fitMeta, cxMeta, entryMeta,
  levers, columns,
} from './vcm-data';
import type { Lever, Row } from './vcm-data';
import VcmControls from './VcmControls.astro';
import VcmFootnote from './VcmFootnote.astro';

const totalUseCases = levers.reduce((n, l) => n + l.rows.length, 0);
---

<section class="vcm" data-vcm aria-label="AI value creation matrix">
  <!-- Controls -->
  <VcmControls totalUseCases={totalUseCases} />

  <!-- Lever sections -->
  {
    levers.map((lever) => (
      <div class="vcm-lever" data-lever-section={lever.key}>
        <div class="vcm-lever-head">
          <span class:list={['vcm-dot', `dot-${lever.key}`]} aria-hidden="true" />
          <h3 class="vcm-lever-title">{lever.title}</h3>
          <span class="vcm-lever-count" data-lever-count={lever.key} />
        </div>
        <div class="table-wrap">
          <table class="vcm-table">
            <thead>
              <tr>{columns.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {lever.rows.map((r) => (
                <tr
                  data-row
                  data-lever={lever.key}
                  data-phase={r.phase}
                  data-tier={r.tier}
                  data-services={r.filterServices}
                >
                  <td class="td-sublever" data-label="Sub-Lever">{r.sublever}</td>
                  <td class="td-usecase" data-label="Use Case">{r.usecase}</td>
                  <td data-label="Phase">
                    <span class:list={['badge', phaseMeta[r.phase].cls]}>{phaseMeta[r.phase].label}</span>
                  </td>
                  <td data-label="Tier">
                    <span class:list={['badge', tierMeta[r.tier]]}>{r.tier}</span>
                  </td>
                  <td class="td-airole" data-label="AI Role">{r.airole}</td>
                  <td class="td-anchor" data-label="Real-World Anchor">{r.anchor}</td>
                  <td data-label="PortCo Pulse Fit">
                    <span class:list={['badge', fitMeta[r.fit]]}>{r.fit}</span>
                  </td>
                  <td data-label="Complexity">
                    <span class:list={['cx', cxMeta[r.complexity]]}>{r.complexity}</span>
                  </td>
                  <td class="td-time" data-label="Time to Value">{r.ttv}</td>
                  <td class="td-time" data-label="Project Duration">{r.duration}</td>
                  <td class="td-deps" data-label="Key Dependencies">{r.deps}</td>
                  <td data-label="Entry Point">
                    <span class:list={['entry', entryMeta[r.entry.type]]}>{r.entry.label}</span>
                  </td>
                  <td class="td-services" data-label="KPMG Services">
                    {r.services.map((s) => (
                      <span class:list={['svc', `svc-${s}`]}>{serviceLabels[s]}</span>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))
  }

  <VcmFootnote />
</section>

<style>
  /* Component-scoped token map: every hue below derives from a wiki design
     token, so nothing is hardcoded. Badge tints are built with color-mix. */
  .vcm {
    --lv-efficiency: var(--kpmg-blue);
    --lv-balance: var(--warning);
    --lv-revenue: var(--kpmg-teal);
    --lv-margin: var(--kpmg-cobalt);
    --lv-inorganic: var(--confidential);

    font-family: var(--font-sans);
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ---- Lever section ---- */
  .vcm-lever {
    margin-bottom: var(--space-8);
  }
  .vcm-lever.is-hidden {
    display: none;
  }
  .vcm-lever-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--line);
  }
  .vcm-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-efficiency {
    background: var(--lv-efficiency);
  }
  .dot-balance {
    background: var(--lv-balance);
  }
  .dot-revenue {
    background: var(--lv-revenue);
  }
  .dot-margin {
    background: var(--lv-margin);
  }
  .dot-inorganic {
    background: var(--lv-inorganic);
  }
  .vcm-lever-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--kpmg-blue);
  }
  .vcm-lever-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  /* ---- Table ---- */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .vcm-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1500px;
  }
  .vcm-table thead th {
    background: var(--kpmg-blue);
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: left;
    padding: 9px 13px;
    white-space: nowrap;
    vertical-align: bottom;
  }
  .vcm-table tbody tr {
    border-bottom: 1px solid var(--line);
    transition: background 0.1s ease;
  }
  .vcm-table tbody tr:last-child {
    border-bottom: none;
  }
  .vcm-table tbody tr:hover {
    background: var(--bg-soft);
  }
  .vcm-table tbody tr.is-hidden {
    display: none;
  }
  .vcm-table td {
    padding: 10px 13px;
    vertical-align: top;
    color: var(--ink-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .td-sublever {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .td-usecase {
    color: var(--kpmg-blue);
    font-weight: 600;
    font-size: 0.82rem;
    min-width: 190px;
    max-width: 220px;
  }
  .td-airole {
    min-width: 240px;
    max-width: 300px;
  }
  .td-anchor {
    min-width: 160px;
    max-width: 200px;
    font-style: italic;
  }
  .td-deps {
    min-width: 170px;
    max-width: 210px;
  }
  .td-time {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .td-services {
    min-width: 180px;
  }

  /* ---- Badges (tints derived from tokens) ---- */
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    font-weight: 500;
    white-space: nowrap;
    margin: 1px 2px 1px 0;
    background: color-mix(in srgb, var(--c) 12%, var(--bg));
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--bg));
  }
  .phase-100 {
    --c: var(--kpmg-cobalt);
  }
  .phase-mid {
    --c: var(--kpmg-blue);
  }
  .phase-exit {
    --c: var(--warning);
  }
  .phase-all {
    --c: var(--kpmg-teal);
  }
  .tier-mm {
    --c: var(--warning);
  }
  .tier-lc {
    --c: var(--kpmg-cobalt);
  }
  .tier-both {
    --c: var(--kpmg-blue);
  }
  .pp-high {
    --c: var(--kpmg-teal);
  }
  .pp-med {
    --c: var(--warning);
  }
  .pp-low {
    --c: var(--ink-muted);
  }

  /* Service badges */
  .svc {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    white-space: nowrap;
    margin: 2px 2px 2px 0;
    background: color-mix(in srgb, var(--c) 12%, var(--bg));
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--bg));
  }
  .svc-strategy {
    --c: var(--kpmg-blue);
  }
  .svc-platform {
    --c: var(--kpmg-cobalt);
  }
  .svc-impl {
    --c: var(--warning);
  }
  .svc-managed {
    --c: var(--kpmg-teal);
  }
  .svc-vc {
    --c: var(--confidential);
  }

  /* Complexity + entry: text-only tokens */
  .cx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .cx-low {
    color: var(--kpmg-teal);
  }
  .cx-med {
    color: var(--warning);
  }
  .cx-high {
    color: var(--confidential);
  }
  .entry {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .entry-build {
    color: var(--kpmg-cobalt);
  }
  .entry-buy {
    color: var(--kpmg-teal);
  }
  .entry-partner {
    color: var(--kpmg-blue);
  }

  /* ---- Mobile: collapse the table into stacked cards ---- */
  @media (max-width: 720px) {
    .table-wrap {
      overflow-x: visible;
      border: none;
      border-radius: 0;
    }
    .vcm-table {
      min-width: 0;
    }
    .vcm-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .vcm-table,
    .vcm-table tbody,
    .vcm-table tr,
    .vcm-table td {
      display: block;
      width: 100%;
    }
    .vcm-table tr {
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--bg);
      padding: var(--space-4);
      margin-bottom: var(--space-4);
      box-shadow: var(--shadow-xs);
    }
    .vcm-table tbody tr:hover {
      background: var(--bg);
    }
    .vcm-table td {
      padding: 5px 0;
      max-width: none !important;
      min-width: 0 !important;
      display: grid;
      grid-template-columns: 40% 1fr;
      gap: var(--space-3);
      align-items: baseline;
      border-bottom: 1px solid var(--line);
    }
    .vcm-table td:last-child {
      border-bottom: none;
    }
    .vcm-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .td-usecase {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // Vanilla-JS multi-select filtering, scoped per matrix instance. Mirrors the
  // island pattern used by PromptCard.astro (no framework, no shared globals).
  document.querySelectorAll<HTMLElement>('[data-vcm]').forEach((root) => {
    const state: Record<string, Set<string>> = {
      phase: new Set(),
      tier: new Set(),
      service: new Set(),
    };

    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-lever-section]'));
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const leverCounts = Array.from(root.querySelectorAll<HTMLElement>('[data-lever-count]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    const label = (n: number) => n + ' use case' + (n !== 1 ? 's' : '');

    function apply() {
      const per: Record<string, number> = {};
      let total = 0;

      rows.forEach((row) => {
        const p = row.dataset.phase || '';
        const t = row.dataset.tier || '';
        const s = (row.dataset.services || '').split(' ');

        const pm = state.phase.size === 0 || state.phase.has(p);
        const tm = state.tier.size === 0 || state.tier.has(t);
        const sm = state.service.size === 0 || s.some((v) => state.service.has(v));

        const show = pm && tm && sm;
        row.classList.toggle('is-hidden', !show);
        if (show) {
          total++;
          const lv = row.dataset.lever || '';
          per[lv] = (per[lv] || 0) + 1;
        }
      });

      leverCounts.forEach((el) => {
        const lv = el.dataset.leverCount || '';
        el.textContent = label(per[lv] || 0);
      });
      sections.forEach((sec) => {
        const lv = sec.dataset.leverSection || '';
        sec.classList.toggle('is-hidden', !per[lv]);
      });
      if (countEl) countEl.textContent = label(total);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.group || '';
        const value = btn.dataset.filter || '';
        const set = state[group];
        if (!set) return;

        if (value === '__all') {
          set.clear();
        } else if (set.has(value)) {
          set.delete(value);
        } else {
          set.add(value);
        }

        // Reflect state on the button row: "All" is active only when the group is empty.
        root.querySelectorAll<HTMLButtonElement>(`[data-group="${group}"]`).forEach((b) => {
          const v = b.dataset.filter || '';
          if (v === '__all') b.classList.toggle('active', set.size === 0);
          else b.classList.toggle('active', set.has(v));
        });

        apply();
      });
    });

    apply();
  });
</script>
