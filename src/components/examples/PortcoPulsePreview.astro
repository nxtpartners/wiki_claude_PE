---
// A styled "mock preview" of the PortCo Pulse Dashboard, framed as a browser
// window. It is pure CSS (no screenshot asset), so it stays crisp at any size
// and on any display, and it links through to the full standalone deliverable.
// Every colour is a wiki design token; the faux tiles and bars only hint at the
// real dashboard, which lives on its own page.
import PreviewFrame from './PreviewFrame.astro';

interface Props {
  href?: string;
}
const { href } = Astro.props;

// A few faux stat tiles and company bar rows that hint at the real dashboard.
// The bar widths and status tints come straight from the showcase's own token
// map so the preview stays on-palette with the real thing.
const tiles = [
  { label: 'Companies', value: '8' },
  { label: 'Pending', value: '2' },
  { label: 'Alerts', value: '2' },
];
const rows = [
  { name: 'Brighton Healthcare', bar: 100, status: 'ontrack' },
  { name: 'Keystone Logistics', bar: 55, status: 'atrisk' },
  { name: 'OptiFi Solutions', bar: 22, status: 'ontrack' },
  { name: 'Evergreen Fitness', bar: 7, status: 'offtrack' },
];
---

<PreviewFrame
  href={href}
  defaultHref="/claude-code/portco-pulse"
  ariaLabel="Open the full PortCo Pulse Dashboard"
  urlLabel="portco-pulse · dashboard"
  ctaText="Open the dashboard"
  caption="Static showcase · Portfolio KPIs, alerts, and submission status."
>
      <div class="pv-tiles">
        {
          tiles.map((t) => (
            <div class="pv-tile">
              <span class="pv-tile-value">{t.value}</span>
              <span class="pv-tile-label">{t.label}</span>
            </div>
          ))
        }
      </div>

      <div class="pv-chart">
        {
          rows.map((r) => (
            <div class:list={['pv-row', `pv-${r.status}`]}>
              <span class="pv-name">{r.name}</span>
              <span class="pv-track"><i style={`width:${r.bar}%`} /></span>
            </div>
          ))
        }
      </div>
</PreviewFrame>

<style>
  /* Body-specific styles for the dashboard preview. Frame, chrome, overlay, CTA,
     caption, hover states, and responsive breakpoints live in PreviewFrame. */
  .pv-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .pv-tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .pv-tile-value {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--kpmg-blue);
  }
  .pv-tile-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pv-chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--bg);
  }
  .pv-row {
    --bar-c: var(--kpmg-blue);
    display: grid;
    grid-template-columns: 1fr 90px;
    align-items: center;
    gap: var(--space-3);
  }
  .pv-atrisk {
    --bar-c: var(--warning);
  }
  .pv-offtrack {
    --bar-c: var(--confidential);
  }
  .pv-name {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--kpmg-blue);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pv-track {
    height: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bar-c) 12%, var(--bg-soft));
    overflow: hidden;
  }
  .pv-track i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bar-c) 78%, var(--bg));
  }

  @media (max-width: 520px) {
    .pv-tiles {
      grid-template-columns: repeat(3, 1fr);
    }
    .pv-name {
      font-size: 0.72rem;
    }
  }
</style>
