---
// A styled "mock preview" of the AI Value Creation Matrix, framed as a browser
// window. It is pure CSS (no screenshot asset), so it stays crisp at any size
// and on any display, and it links through to the full standalone deliverable.
// Every colour is a wiki design token; the faux rows only hint at the real
// matrix, which lives on its own page.
import PreviewFrame from './PreviewFrame.astro';

interface Props {
  href?: string;
}
const { href } = Astro.props;

// A few representative levers to tint the faux rows, straight from the matrix's
// own lever token map so the preview stays on-palette with the real thing.
const previewRows = [
  { lever: 'efficiency', name: 'SG&A Benchmarking & Anomaly Detection', phase: '100-Day' },
  { lever: 'revenue', name: 'Churn Prediction & Retention Signals', phase: 'Mid-Hold' },
  { lever: 'margin', name: 'AI-Assisted Dynamic Pricing', phase: 'Mid-Hold' },
  { lever: 'inorganic', name: 'Cross-Portfolio Spend Consolidation', phase: 'Exit Prep' },
];
---

<PreviewFrame
  href={href}
  defaultHref="/claude-code/value-creation-matrix"
  ariaLabel="Open the full AI Value Creation Matrix"
  urlLabel="claude · ai-value-creation-matrix"
  ctaText="Open the full matrix"
  caption="Interactive · Filter by phase, fund tier, and KPMG service line."
>
      <div class="mp-filters">
        <span class="mp-chip mp-chip-on">All phases</span>
        <span class="mp-chip">100-Day</span>
        <span class="mp-chip">Mid-Hold</span>
        <span class="mp-chip">Exit Prep</span>
        <span class="mp-count">19 use cases</span>
      </div>

      <div class="mp-table">
        <div class="mp-thead">
          <span>Use case</span>
          <span>Phase</span>
          <span>Fit</span>
        </div>
        {
          previewRows.map((r) => (
            <div class="mp-row">
              <span class="mp-cell mp-usecase">
                <span class:list={['mp-dot', `mp-dot-${r.lever}`]} />
                {r.name}
              </span>
              <span class="mp-cell mp-badge">{r.phase}</span>
              <span class="mp-cell mp-bar"><i /></span>
            </div>
          ))
        }
      </div>
</PreviewFrame>

<style>
  /* Body-specific styles for the matrix preview. Frame, chrome, overlay, CTA,
     caption, hover states, and responsive breakpoints live in PreviewFrame. */
  .mp-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-4);
  }
  .mp-chip {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 3px 10px;
  }
  .mp-chip-on {
    background: var(--kpmg-blue);
    border-color: var(--kpmg-blue);
    color: #fff;
    font-weight: 600;
  }
  .mp-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  .mp-table {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .mp-thead {
    display: grid;
    grid-template-columns: 1fr 90px 70px;
    gap: var(--space-3);
    padding: 8px 12px;
    background: var(--kpmg-blue);
  }
  .mp-thead span {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }
  .mp-row {
    display: grid;
    grid-template-columns: 1fr 90px 70px;
    gap: var(--space-3);
    align-items: center;
    padding: 9px 12px;
    border-top: 1px solid var(--line);
  }
  .mp-cell {
    min-width: 0;
  }
  .mp-usecase {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--kpmg-blue);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-dot {
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .mp-dot-efficiency {
    background: var(--kpmg-blue);
  }
  .mp-dot-revenue {
    background: var(--kpmg-teal);
  }
  .mp-dot-margin {
    background: var(--kpmg-cobalt);
  }
  .mp-dot-inorganic {
    background: var(--confidential);
  }
  .mp-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--kpmg-cobalt);
    background: color-mix(in srgb, var(--kpmg-cobalt) 12%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--kpmg-cobalt) 30%, var(--bg));
    border-radius: var(--radius-sm);
    padding: 2px 7px;
    justify-self: start;
  }
  .mp-bar {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--kpmg-teal) 18%, var(--bg));
    overflow: hidden;
  }
  .mp-bar i {
    display: block;
    height: 100%;
    width: 72%;
    background: var(--kpmg-teal);
  }

  @media (max-width: 520px) {
    .mp-thead,
    .mp-row {
      grid-template-columns: 1fr 70px 48px;
    }
    .mp-usecase {
      font-size: 0.72rem;
    }
  }
</style>
