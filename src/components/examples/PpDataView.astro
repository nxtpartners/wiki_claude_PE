---
// Data (KPI table) view for the PortCo Pulse showcase.
import { kpiRows, fiscalYear } from './pp-data';
---

<div class="pp-view" data-view="data">
  <!-- Data header -->
  <div class="pp-head">
    <div>
      <p class="pp-eyebrow">Company Analytics</p>
      <h3 class="pp-title">Veridian Software</h3>
    </div>
    <span class="pp-fy">{fiscalYear} plan</span>
  </div>

  <!-- Company analytics KPI table -->
  <div class="pp-panel">
    <div class="pp-panel-head">
      <h4 class="pp-panel-title">Company Analytics</h4>
      <span class="pp-panel-note">Veridian Software</span>
    </div>
    <div class="pp-table-wrap">
      <table class="pp-table">
        <thead>
          <tr>
            <th>KPI</th>
            <th>Actual</th>
            <th>Plan</th>
            <th>Var %</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {
            kpiRows.map((r) => (
              <tr>
                <td class="pp-td-kpi" data-label="KPI">{r.kpi}</td>
                <td class="pp-td-num" data-label="Actual">{r.actual}</td>
                <td class="pp-td-num" data-label="Plan">{r.plan}</td>
                <td class="pp-td-num" data-label="Var %">{r.variance}</td>
                <td data-label="Status">
                  <span class:list={['pp-badge', `st-${r.status}`]}>{r.statusLabel}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  /* ---- View header (duplicated per Astro scoping) ---- */
  .pp-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .pp-eyebrow {
    margin: 0 0 2px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kpmg-cobalt);
  }
  .pp-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pp-fy {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 4px 10px;
  }

  /* ---- Switchable views ---- */
  .pp-view {
    display: none;
    flex-direction: column;
    gap: var(--space-6);
  }
  .pp-view.active {
    display: flex;
  }

  /* ---- Panels ---- */
  .pp-panel {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .pp-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .pp-panel-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--kpmg-blue);
  }
  .pp-panel-note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  /* ---- KPI table ---- */
  .pp-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .pp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }
  .pp-table thead th {
    background: var(--kpmg-blue);
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: left;
    padding: 9px 13px;
    white-space: nowrap;
  }
  .pp-table tbody tr {
    border-bottom: 1px solid var(--line);
  }
  .pp-table tbody tr:last-child {
    border-bottom: none;
  }
  .pp-table tbody tr:hover {
    background: var(--bg-soft);
  }
  .pp-table td {
    padding: 10px 13px;
    vertical-align: middle;
    color: var(--ink-muted);
    font-size: 0.82rem;
  }
  .pp-td-kpi {
    font-weight: 600;
    color: var(--ink);
  }
  .pp-td-num {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ink);
  }

  /* ---- Status badges (tints derived from tokens) ---- */
  .pp-badge {
    display: inline-block;
    padding: 2px 9px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    font-weight: 500;
    white-space: nowrap;
    background: color-mix(in srgb, var(--c) 12%, var(--bg));
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--bg));
  }
  .st-ontrack { --c: var(--kpmg-teal); }
  .st-atrisk { --c: var(--warning); }
  .st-offtrack { --c: var(--confidential); }

  /* ---- Mobile: KPI table collapses to stacked cards ---- */
  @media (max-width: 720px) {
    .pp-table-wrap {
      overflow-x: visible;
      border: none;
      border-radius: 0;
    }
    .pp-table {
      min-width: 0;
    }
    .pp-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .pp-table,
    .pp-table tbody,
    .pp-table tr,
    .pp-table td {
      display: block;
      width: 100%;
    }
    .pp-table tr {
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--bg);
      padding: var(--space-4);
      margin-bottom: var(--space-3);
      box-shadow: var(--shadow-xs);
    }
    .pp-table tbody tr:hover {
      background: var(--bg);
    }
    .pp-table td {
      padding: 5px 0;
      display: grid;
      grid-template-columns: 40% 1fr;
      gap: var(--space-3);
      align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .pp-table td:last-child {
      border-bottom: none;
    }
    .pp-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
  }
</style>
