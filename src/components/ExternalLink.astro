---
// A link that leaves the wiki. It opens in a new tab, so the reader keeps their
// place, and says so twice: an arrow for the eye, hidden text for a screen
// reader. Rest props are spread so a parent's scoped styles reach the anchor.
interface Props {
  href: string;
  class?: string;
  // The header logo is an image link; an arrow beside it would read as clutter.
  arrow?: boolean;
  [key: string]: unknown;
}
const { href, class: className, arrow = true, ...rest } = Astro.props;
---

<a href={href} class:list={['ext-link', className]} target="_blank" rel="noopener" {...rest}
  ><slot />{arrow && <span class="ext-arrow" aria-hidden="true">↗</span>}<span class="visually-hidden"
    > (opens in a new tab)</span
  ></a
>

<style>
  .ext-arrow {
    margin-inline-start: 0.25em;
    font-size: 0.9em;
  }
</style>
