---
// A link that leaves the wiki for another NXT site. It opens in the same tab
// (user, 2026-10-05): the wiki and pe.nxtpartners.ai are one family and link to
// each other the same way, so leaving one for the other is ordinary navigation.
// Every such link goes through here, so how they behave is decided once.
// Rest props are spread so a parent's scoped styles reach the anchor.
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}
const { href, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['ext-link', className]} {...rest}><slot /></a>
