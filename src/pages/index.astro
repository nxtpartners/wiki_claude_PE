---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/withBase';
import twoPaths from '../assets/diagrams/home-two-paths.png';
---

<BaseLayout title="Home">
  <Header />

  <main id="main">
    <!-- ===================== HERO ===================== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-rule" aria-hidden="true"></div>
      <div class="container hero-grid">
        <!-- Left: the pitch -->
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-title" data-hero="2">
            Claude for Private Equity
          </h1>
          <p class="hero-sub" data-hero="3">
            One Claude, two ways to work: claude.ai for everyday questions, and Claude Code for advanced, hands-on work in your files.
          </p>
          <div class="hero-actions" data-hero="4">
            <a href={withBase('/welcome')} class="btn btn-primary">Start with claude.ai</a>
            <a href={withBase('/claude-code/welcome')} class="btn btn-secondary">Explore Claude Code</a>
          </div>
          <p class="hero-meta mono-meta" data-hero="5">
            For Claude Enterprise &amp; Team · Self-paced · Foundations included if you need them
          </p>
        </div>

        <!-- Right: the signature element, a diagram of the two ways to work -->
        <div class="hero-demo" data-hero="6">
          <Image
            src={twoPaths}
            alt="One Claude, two ways to work. Your private equity work flows into two paths: claude.ai in the browser for questions, analysis, and drafting, and Claude Code in your files for hands-on work. Both reach a confident, verified result that stays confidential by design."
            class="hero-diagram"
            loading="eager"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---------- Shared institutional accents ---------- */
  .mono-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    background:
      radial-gradient(ellipse 60% 70% at 88% 0%, rgba(30, 73, 226, 0.06), transparent 60%),
      var(--bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero-rule {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(0, 51, 141, 0.035) 1px, transparent 1px);
    background-size: 96px 100%;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-12);
    align-items: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }
  .hero-copy {
    max-width: 36rem;
  }
  .hero-title {
    margin: 0 0 var(--space-6);
    font-size: clamp(2.4rem, 1.6rem + 2.8vw, 3.7rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.038em;
    color: var(--ink);
  }
  .hero-sub {
    margin: 0 0 var(--space-8);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.22rem);
    line-height: 1.62;
    color: var(--ink-muted);
    max-width: 40ch;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hero-meta {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  /* ---- Signature diagram card ---- */
  .hero-demo {
    position: relative;
  }
  .hero-diagram {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    background: var(--bg);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .hero {
      min-height: 0;
      display: block;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }
    .hero-copy {
      max-width: none;
    }
  }


</style>

<script>
  import '../scripts/motion.ts';

  // Scoped, restrained build-in for the conversation card. Respects reduced motion.
  // The global motion system handles [data-hero] and [data-reveal]; this adds the
  // chat bubbles staggering in after the hero settles.
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bubbles = Array.from(document.querySelectorAll<HTMLElement>('[data-chat]'));
    if (!bubbles.length) return;

    if (reduce) {
      bubbles.forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      return;
    }

    bubbles
      .sort((a, b) => Number(a.dataset.chat) - Number(b.dataset.chat))
      .forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(14px)';
        el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
        window.setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        }, 620 + i * 220);
      });
  })();
</script>
