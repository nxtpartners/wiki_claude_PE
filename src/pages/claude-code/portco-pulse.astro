---
// Standalone full-width deliverable: the PortCo Pulse Dashboard.
// This is the "finished artifact" that Example 2 walks you through building.
import DeliverableLayout from '../../layouts/DeliverableLayout.astro';
import PortcoPulseShowcase from '../../components/examples/PortcoPulseShowcase.astro';
import { withBase } from '../../utils/withBase';

const walkthroughHref = '/claude-code/example-portco-pulse';
---

<DeliverableLayout
  title="PortCo Pulse Dashboard"
  description="A portfolio-monitoring dashboard for a private equity fund: monthly KPI tracking, plan-vs-actual variance, and automated off-track alerts across the portfolio."
  walkthroughHref={walkthroughHref}
  subtitle={`A portfolio-monitoring dashboard for a private equity fund. Eight portfolio companies submit monthly KPIs against an annual plan, and the dashboard surfaces revenue performance, plan-vs-actual variance, and the companies that are off track. This is the finished deliverable that the <a href="${withBase(walkthroughHref)}">Example 2 walkthrough</a> shows you how to assemble with Claude.`}
>
  <PortcoPulseShowcase />
</DeliverableLayout>
