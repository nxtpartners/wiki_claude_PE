---
import '../styles/global.css';
import { NXT_SITE } from '../config/nav';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Claude.ai for private equity professionals: from basics to confident daily use.' } =
  Astro.props;

const fullTitle = title === 'Home' ? 'Claude for Private Equity · NXT Partners AI' : `${title} · Claude for PE`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Paired with --chrome-bg in global.css (a meta tag cannot read a CSS variable). Change both together. -->
    <meta name="theme-color" content="#0e0a20" />
    <!-- NXT's own icons, served by pe.nxtpartners.ai; never redrawn (see tasks/standards.md, Seam 5). -->
    <link rel="icon" type="image/png" sizes="16x16" href={NXT_SITE.icons.png16} />
    <link rel="icon" type="image/png" sizes="32x32" href={NXT_SITE.icons.png32} />
    <link rel="apple-touch-icon" sizes="180x180" href={NXT_SITE.icons.apple} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 1000;
    background: var(--brand-ink);
    color: var(--on-dark);
    padding: 10px 16px;
    border-radius: var(--radius-md);
    transition: top 0.18s ease;
  }
  .skip-link:focus {
    top: 16px;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
